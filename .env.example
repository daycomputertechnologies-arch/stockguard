# Copy to .env and fill in. Never commit .env.

# --- backend ---
DATABASE_PATH=./stockguard.db
SEED_DIR=../../packages/shared/seed
DEMO_TOKEN=stockguard-demo
ALLOW_DEMO_ENDPOINTS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- chain ---
# fake  = in-memory, no RPC, always works (default for local + safe demo)
# fuji  = live Avalanche Fuji testnet
CHAIN_MODE=fake
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
CONTRACT_ADDRESS=
OPERATOR_PRIVATE_KEY=
EXPLORER_BASE=https://testnet.snowtrace.io

# --- ai (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- frontend (build time) ---
VITE_API_BASE=/api
VITE_DEMO_TOKEN=stockguard-demo
VITE_EXPLORER_BASE=https://testnet.snowtrace.io
